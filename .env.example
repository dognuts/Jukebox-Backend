# Server
PORT=8080
ENV=development

# PostgreSQL
DATABASE_URL=postgres://jukebox:jukebox@localhost:5432/jukebox?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Session
SESSION_TTL_HOURS=24

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT — REQUIRED. The server refuses to boot when this is unset, a known
# placeholder, or under 32 chars (a forgeable secret = full auth bypass).
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Cloudflare Turnstile (signup CAPTCHA)
# Create a widget at https://dash.cloudflare.com → Turnstile.
# The SECRET key goes here; the SITE key goes in the frontend env as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY. Leave blank to disable (dev only —
# the server logs a loud warning when this is unset).
TURNSTILE_SECRET_KEY=

# Resend (email delivery)
# Sign up at https://resend.com and get an API key
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=noreply@yourdomain.com

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# YouTube Data API v3 (for admin bulk track search on /admin/autoplay)
# Get a key at https://console.cloud.google.com → APIs & Services → Credentials
# Leave blank to disable Bulk mode; URL-paste mode keeps working either way.
YOUTUBE_DATA_API_KEY=

# Enable no-Stripe instant-activation billing stubs (LOCAL DEV ONLY —
# grants Plus/Neon/DJ subs for free; production must never set this)
DEV_PAYMENTS=false
